sub term_size {
    my $out = '';
    if (-t STDOUT || -t STDERR) {
        $out = `stty size 2>/dev/null </dev/tty` || '';
    }
    if ($out =~ /^\s*(\d+)\s+(\d+)/) { ($term_h, $term_w) = ($1, $2) }
    else {
        $term_h = $ENV{LINES}   || 24;
        $term_w = $ENV{COLUMNS} || 80;
    }
    $term_w = 40  if $term_w < 40;
    $term_h = 10  if $term_h < 10;
}

