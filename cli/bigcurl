#!/usr/bin/env perl
#
# bigcurl - download big files fast, in parallel chunks, resumably.
#
# Wraps curl. Each chunk is a separate `curl --range` process writing to a pipe;
# bigcurl multiplexes those pipes in a single-process event loop and writes the
# bytes straight into a sparse output file at the correct offset. curl does all
# the HTTP/TLS/auth/redirect/proxy work; bigcurl does scheduling, resume,
# retries, adaptive tuning and the display.
#
#   bigcurl https://host/big.iso
#   bigcurl -d models https://host/shard-1.bin https://host/shard-2.bin
#   bigcurl -l -n 16 -u user:pass https://host/private.tar
#
# Interrupted downloads resume automatically: bytes land in <name>.part and a
# sidecar <name>.part.state records which blocks are complete.
#
# Joe Walnes <joe@walnes.com>, 2026, MIT License
# https://github.com/joewalnes/onesies

use strict;
use warnings;

our $VERSION = '1.0.0';

# ---------------------------------------------------------------------------
# Configuration
#
# AIDEV-NOTE: Every tunable lives in this block. Most are also CLI flags; the
# values here are the defaults used when the flag is absent.
# ---------------------------------------------------------------------------

# Parallelism. Starts at CONNS_START and climbs while throughput improves.
#
# AIDEV-NOTE: 32 is deliberate and measured. Under packet loss per-connection
# throughput varies wildly, so many connections each doing small requests beat
# fewer connections doing big ones by ~2x (it is how aria2 wins with dynamic
# 1MB pieces); on a clean high-RTT link 32 parallel slow-starts still grow the
# aggregate window faster than one stream does. In the netem lab -n 32 won or
# tied every cell, lossy and clean. The tuner shrinks the pool on 429/503 or a
# high error rate, so a server that caps connections per IP is still handled.
my $CONNS_START      = 32;        # connections opened at the start
my $CONNS_MAX        = 64;        # never exceed this many concurrent curls
my $CONNS_MIN        = 4;         # never drop below this (1 if file is tiny)
my $CONNS_STEP       = 4;         # add/remove this many per tuning decision
my $TUNE_INTERVAL    = 2.0;       # seconds between tuning decisions
my $CONNS_STEP_DOWN  = 2;         # shrink more slowly than we grow
my $TUNE_GAIN        = 1.03;      # speed must beat best by this to grow
my $TUNE_LOSS        = 0.90;      # speed below best*this shrinks
my $TUNE_DECAY       = 0.98;      # decay remembered best so we re-explore
my $TUNE_ERR_RATE    = 0.30;      # retry fraction that means "too many connections"

# Block sizing. Block size is the resume granularity and is fixed per file
# (changing it would invalidate a saved bitmap). Requests are made larger
# dynamically by coalescing adjacent blocks instead - see $COALESCE_MAX.
my $BLOCK_SIZE       = 0;         # 0 = auto from file size (see block_size())
my $COALESCE_MIN     = 1;         # min adjacent blocks fetched per curl
my $COALESCE_MAX     = 32;        # max adjacent blocks fetched per curl
my $REQ_TARGET_SECS  = 8;         # aim for this much transfer per request
my $STEAL_MIN_SECS   = 3;         # only steal from a worker with at least this long left
my $MIN_REQ          = 1 << 20;   # never issue a range request smaller than this

# Hedging. Once a file is down to its last few blocks, an idle connection
# (one pick_work and steal_work both had nothing else to give) may duplicate
# a block already in flight; whichever copy lands first wins and the other is
# killed. See the AIDEV-NOTE above hedge_work() for why this is bounded the
# way it is - in short, it never grows the pool and never competes with
# ordinary work for a slot, only spends genuinely idle ones.
#
# AIDEV-NOTE: Off by default (0) even though the mechanism works, because
# the two regimes it was measured in point opposite ways and there is no
# runtime signal yet to tell them apart. Measured, -n32 matched, sha256
# verified, median of the -l trace's 90%-to-done tail:
#   - Simulated packet loss (netem): +32% at rtt250ms/0.5% loss, +23% at
#     rtt100ms/0.5% loss, +43% on a connection-capped origin (limit_conn 4)
#     with loss layered on top - complete rank separation in all three
#     (every hedged rep beat every unhedged rep), n=3 reps/arm each.
#   - Starlink (this project's actual noisy real-world link, and the one
#     ASKS.md item 3 names as the measurement to use): -31% (0.95s slower
#     at the median, 4.01s vs 3.06s), direction consistent across every
#     rep though the n=6-7/arm spreads overlap. A hedge duplicate on a
#     fresh connection routes around an isolated straggler under netem's
#     per-connection loss model; on a real, shared, bandwidth-capped link
#     it just competes with the original for the same limited pipe.
# Turn it on (--hedge N) where the link is known to be loss-limited rather
# than bandwidth-contended. Flipping the default back to nonzero needs a
# way to tell the two regimes apart at runtime, or a measurement that the
# Starlink number was noise, neither of which exists yet - not a smaller
# number here.
my $HEDGE_TAIL_BLOCKS = 0;        # hedge only once a file has this few (or fewer)
                                   # undone blocks left; 0 disables hedging entirely (default)
my $HEDGE_MIN_SECS    = 2;        # like $STEAL_MIN_SECS but for hedging: don't bother
                                   # duplicating a request that will finish sooner than this
my $HEDGE_MAX         = 2;        # cap on concurrent hedge duplicates, so a server that
                                   # meters connections per IP sees at worst this many extra
my $HEDGE_MAX_BUF     = 64 << 20; # a hedge duplicate's bytes are buffered in memory until
                                   # it either wins (see hedge_flush()) or loses, rather than
                                   # written as they arrive - so its memory cost is one whole
                                   # span, span*block_size, times up to $HEDGE_MAX at once.
                                   # Block size is user-controlled (-B), so without this a
                                   # large -B would make hedging allocate proportionally -
                                   # this refuses to hedge any span bigger than 64MiB instead
                                   # (128MiB worst case at the default $HEDGE_MAX of 2), which
                                   # covers every block size this file has ever been measured
                                   # with by a wide margin.

# Reliability.
my $MAX_RETRIES      = 5;         # attempts per block before the file fails
my $STALL_SECS       = 30;        # kill+retry a connection idle this long
my $CONNECT_TIMEOUT  = 15;        # curl --connect-timeout
my $BACKOFF_BASE     = 0.5;       # first retry delay, doubles each attempt
my $BACKOFF_MAX      = 30;        # cap on retry delay
my $PROBE_CONNS      = 16;        # concurrent probe/first-block requests while sizing files
my $PROBE_RANGE      = 1 << 20;   # bytes requested by the probe when -B isn't given and more
                                   # than one URL was asked for - a whole file this size or
                                   # smaller needs no further request at all
my $PROBE_RANGE_SOLO = 8 << 10;   # ...but for a single URL, only this much: one initial TCP
                                   # congestion window (10 x 1448B on Linux and macOS), so the
                                   # probe body costs no extra round trip over a bare HEAD
my $PROBE_MAX        = 4 << 20;   # give up on the probe body past this many bytes - a server
                                   # that ignores Range would otherwise hand us the whole file

# Output.
my $READ_CHUNK       = 1 << 20;   # bytes read from a curl pipe per wakeup
my $PIPE_SIZE        = 1 << 20;   # Linux: grow each curl pipe to this (F_SETPIPE_SZ)
my $SMALL_READ       = 256 << 10; # a read shorter than this means the pipe is trickling...
my $HOLD_BIG         = 0.020;     # ...so leave it alone this long if the pipe is large
my $HOLD_SMALL       = 0.004;     # ...or this long if it is a default 64KB pipe
my $LOG_INTERVAL     = 1.0;       # seconds between progress lines in log mode
my $FRAME_INTERVAL   = 0.1;       # pretty-mode redraw interval (10fps)
my $SAMPLE_INTERVAL  = 0.5;       # seconds per speed-history sample
my $HISTORY_MAX      = 400;       # speed samples kept for the sparkline
my $SPEED_EMA        = 0.25;      # smoothing factor for displayed speed
my $STATE_INTERVAL   = 2.0;       # seconds between resume-state saves

# Exit codes. Also documented in --help so scripts and agents can rely on them.
my $EX_OK            = 0;         # everything downloaded
my $EX_FAIL          = 1;         # one or more downloads failed (mixed causes)
my $EX_USAGE         = 2;         # bad command line
my $EX_NETWORK       = 3;         # retries exhausted / transport failure
my $EX_HTTP          = 4;         # HTTP 4xx: auth required, forbidden, missing
my $EX_DISK          = 5;         # could not create or write the output file
my $EX_INTERRUPT     = 6;         # SIGINT/SIGTERM; state saved, resumable
my $EX_NOCURL        = 7;         # curl not found on PATH

# AIDEV-NOTE: EINTR is 4 on Linux, macOS and the BSDs. Hardcoded so the script
# needs no modules at all (Errno is absent from stripped perl installs such as
# Debian's perl-base).
my $EINTR = 4;

# ---------------------------------------------------------------------------
# Portability shims - no non-pragma modules are used anywhere in this file.
# ---------------------------------------------------------------------------

sub cpu_count {
    my $n = 0;
    if (open(my $fh, '<', '/proc/cpuinfo')) {
        while (<$fh>) { $n++ if /^processor\s*:/ }
        close $fh;
    }
    if (!$n) {
        my $out = `sysctl -n hw.ncpu 2>/dev/null`;
        $n = $1 if defined $out && $out =~ /^\s*(\d+)/;
    }
    return $n || 4;
}

my $HIRES = eval { require Time::HiRes; 1 } ? 1 : 0;
sub now { return $HIRES ? Time::HiRes::time() : time(); }

# ---------------------------------------------------------------------------
# Formatting helpers
# ---------------------------------------------------------------------------

sub fmt_bytes {
    my ($n) = @_;
    return '?' unless defined $n && $n >= 0;
    my @u = ('B', 'KB', 'MB', 'GB', 'TB', 'PB');
    my $i = 0;
    my $v = $n + 0;
    while ($v >= 1024 && $i < $#u) { $v /= 1024; $i++ }
    return sprintf('%d %s', $v, $u[$i]) if $i == 0;
    return sprintf('%.1f %s', $v, $u[$i]);
}

sub fmt_rate {
    my ($n) = @_;
    return '--' unless defined $n && $n > 0;
    return fmt_bytes($n) . '/s';
}

sub fmt_dur {
    my ($s) = @_;
    return '--:--' unless defined $s && $s >= 0 && $s < 360000;
    $s = int($s);
    my $h = int($s / 3600);
    my $m = int(($s % 3600) / 60);
    my $x = $s % 60;
    return sprintf('%d:%02d:%02d', $h, $m, $x) if $h;
    return sprintf('%02d:%02d', $m, $x);
}

sub parse_size {
    my ($s) = @_;
    return undef unless defined $s && $s =~ /^\s*([0-9]*\.?[0-9]+)\s*([kmgtKMGT]?)[bB]?\s*$/;
    my ($n, $u) = ($1, lc($2 || ''));
    my %mul = ('' => 1, k => 1024, m => 1024**2, g => 1024**3, t => 1024**4);
    return int($n * $mul{$u});
}

# Split a string into argv the way a shell would, honouring quotes.
sub shell_split {
    my ($s) = @_;
    my @out;
    return @out unless defined $s;
    while ($s =~ /\G\s*(?:'([^']*)'|"((?:[^"\\]|\\.)*)"|([^\s'"]+))/gc) {
        my $tok = defined $1 ? $1 : defined $2 ? do { my $t = $2; $t =~ s/\\(.)/$1/g; $t } : $3;
        push @out, $tok;
    }
    return @out;
}

# ---------------------------------------------------------------------------
# Usage
#
# AIDEV-NOTE: --help is the machine-readable contract too. Agents and scripts
# are expected to read the EXIT CODES and LOG FORMAT sections from here, so
# keep them accurate whenever behaviour changes.
# ---------------------------------------------------------------------------

sub usage {
    my ($fh) = @_;
    print $fh <<"HELPTEXT";
bigcurl $VERSION - download big files fast, in parallel chunks, resumably.

USAGE
  bigcurl [options] URL...
  bigcurl [options] -i urls.txt
  cat urls.txt | bigcurl [options] -i -

Splits each file into blocks and fetches them with several concurrent curl
processes using HTTP range requests, tuning the number of connections to
whatever the network is actually doing. Interrupted downloads resume where
they left off. Works with http and https.

OPTIONS
  -o FILE          write to FILE (only valid with a single URL)
  -d DIR           write into DIR (default: current directory)
  -i FILE          read URLs from FILE, one per line ('-' for stdin)
  -n N             max parallel connections (default: adaptive, up to $CONNS_MAX)
  -B SIZE          block size, e.g. 4M (default: chosen from the file size)
  -f               re-download even if the output file is already complete
  -R               restart: discard any saved resume state
  -s               silent: no output at all, just the exit code
  -l               log: one JSON object per line on stdout (default: no TTY)
  -p               pretty: full-screen dashboard (default: on a TTY)
  --retries N      attempts per block before giving up (default: $MAX_RETRIES)
  --stall SECS     kill and retry a connection idle this long (default: $STALL_SECS)
  --hedge N        duplicate an in-flight block onto a spare connection once this
                    few (or fewer) remain, keeping whichever lands first (default:
                    $HEDGE_TAIL_BLOCKS; 0 disables)
  -h, --help       this help
  -V, --version    print version

AUTHENTICATION AND TRANSPORT (passed straight through to curl)
  -u USER:PASS     HTTP auth; the scheme (basic, digest, ntlm, negotiate) is
                   negotiated automatically via curl --anyauth
  -H 'K: V'        add a header, repeatable (e.g. -H 'Authorization: Bearer ...')
  -k               allow insecure TLS certificates
  -A UA            user agent          -e URL      referer
  -b COOKIE        cookie              --netrc     read credentials from ~/.netrc
  --compressed     accept compressed transfer encodings
  --proxy URL      proxy               --cacert FILE / --cert FILE / --key FILE
  --curl 'ARGS'    any other curl arguments, verbatim, repeatable

EXAMPLES
  bigcurl https://host/ubuntu.iso
  bigcurl -d ./models https://host/shard-1.bin https://host/shard-2.bin
  bigcurl -H 'Authorization: Bearer \$TOKEN' https://host/private.bin
  bigcurl -u alice:secret https://host/protected.tar
  bigcurl -l -n 16 https://host/big.tar > progress.jsonl
  bigcurl --curl '--proxy socks5://localhost:1080' https://host/big.bin

EXIT CODES
  $EX_OK  all files downloaded successfully
  $EX_FAIL  one or more downloads failed (mixed or unclassified causes)
  $EX_USAGE  usage error (bad flags or no URLs)
  $EX_NETWORK  transport failure, retries exhausted
  $EX_HTTP  HTTP 4xx - authentication required, forbidden or not found
  $EX_DISK  could not create or write the output file
  $EX_INTERRUPT  interrupted; partial data and resume state were saved
  $EX_NOCURL  curl was not found on PATH

LOG FORMAT (-l)
  One JSON object per line on stdout, with "event" one of:
    start    file url size blocks block_size resume         a file began
    progress file done size pct speed conns eta             every ${LOG_INTERVAL}s
    retry    file block attempt reason backoff              a block is retried
    skip     file reason                                    already complete
    done     file bytes seconds speed                       a file finished
    error    file message http                              a file failed
    summary  files ok failed skipped bytes seconds exit      last line, always
  Fields are stable; new fields may be added. Errors also go to stderr.

FILES
  <output>.part          partial data, renamed into place when complete
  <output>.part.state    resume state; removed on success
HELPTEXT
}

# ---------------------------------------------------------------------------
# Command line
# ---------------------------------------------------------------------------

my (@urls, $opt_out, $opt_dir, $opt_input, $opt_conns, $opt_block);
my ($opt_force, $opt_restart, $opt_mode);
my @curl_extra;

sub die_usage {
    my ($msg) = @_;
    print STDERR "bigcurl: $msg\n";
    print STDERR "Try 'bigcurl --help' for usage.\n";
    exit $EX_USAGE;
}

sub parse_args {
    my @argv = @_;
    my $only_urls = 0;
    while (@argv) {
        my $a = shift @argv;
        if ($only_urls || $a !~ /^-./) { push @urls, $a; next }
        my $need = sub {
            die_usage("option $a requires a value") unless @argv;
            return shift @argv;
        };
        if    ($a eq '--')            { $only_urls = 1 }
        elsif ($a eq '-h' || $a eq '--help')    { usage(\*STDOUT); exit $EX_OK }
        elsif ($a eq '-V' || $a eq '--version') { print "bigcurl $VERSION\n"; exit $EX_OK }
        elsif ($a eq '-o' || $a eq '--output')  { $opt_out   = $need->() }
        elsif ($a eq '-d' || $a eq '--dir')     { $opt_dir   = $need->() }
        elsif ($a eq '-i' || $a eq '--input')   { $opt_input = $need->() }
        elsif ($a eq '-n')            { $opt_conns = $need->() }
        elsif ($a eq '-B')            { $opt_block = $need->() }
        elsif ($a eq '-f' || $a eq '--force')   { $opt_force = 1 }
        elsif ($a eq '-R' || $a eq '--restart') { $opt_restart = 1 }
        elsif ($a eq '-s' || $a eq '--silent')  { $opt_mode = 'silent' }
        elsif ($a eq '-l' || $a eq '--log')     { $opt_mode = 'log' }
        elsif ($a eq '-p' || $a eq '--pretty')  { $opt_mode = 'pretty' }
        elsif ($a eq '--retries')     { $MAX_RETRIES = $need->() }
        elsif ($a eq '--stall')       { $STALL_SECS  = $need->() }
        elsif ($a eq '--hedge')       { $HEDGE_TAIL_BLOCKS = $need->() }
        elsif ($a eq '--curl')        { push @curl_extra, shell_split($need->()) }
        # curl passthrough: flags that take a value
        elsif ($a eq '-u' || $a eq '--user')   { push @curl_extra, '--anyauth', '-u', $need->() }
        elsif ($a eq '-H' || $a eq '--header') { push @curl_extra, '-H', $need->() }
        elsif ($a eq '-A' || $a eq '--user-agent') { push @curl_extra, '-A', $need->() }
        elsif ($a eq '-e' || $a eq '--referer')    { push @curl_extra, '-e', $need->() }
        elsif ($a eq '-b' || $a eq '--cookie')     { push @curl_extra, '-b', $need->() }
        elsif ($a eq '--proxy'  || $a eq '--cacert' ||
               $a eq '--cert'   || $a eq '--key'   ||
               $a eq '--capath' || $a eq '--interface') { push @curl_extra, $a, $need->() }
        # curl passthrough: boolean flags
        elsif ($a eq '-k' || $a eq '--insecure') { push @curl_extra, '-k' }
        elsif ($a eq '--netrc' || $a eq '--compressed' || $a eq '--http2' ||
               $a eq '--http1.1' || $a eq '--ipv4' || $a eq '--ipv6') { push @curl_extra, $a }
        elsif ($a =~ /^--(retries|stall|hedge)=(.*)$/) {
            if    ($1 eq 'retries') { $MAX_RETRIES = $2 }
            elsif ($1 eq 'stall')   { $STALL_SECS  = $2 }
            else                    { $HEDGE_TAIL_BLOCKS = $2 }
        }
        elsif ($a =~ /^-([a-zA-Z]{2,})$/ && $a !~ /^--/) {
            # bundled short flags, e.g. -fkp
            unshift @argv, map { "-$_" } split //, $1;
        }
        else { die_usage("unknown option '$a'") }
    }
}

